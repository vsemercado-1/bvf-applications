# ---- Airtable -------------------------------------------------------------
# Personal access token with scopes: data.records:read, data.records:write,
# schema.bases:read (and schema.bases:write if you use the setup script).
AIRTABLE_TOKEN=pat_xxxxxxxxxxxxxxxx
# Base ID. The "BVF 2027 Applications" base already exists with every field the app expects:
AIRTABLE_BASE_ID=app6wXbILaYobWhzL
# Only needed if you ever re-run scripts/setup-airtable.mjs to create a fresh base.
AIRTABLE_WORKSPACE_ID=

# ---- Reviewer accounts ----------------------------------------------------
# JSON array. Each reviewer logs in with email + password.
# "lane" is the interview focus shown on the prep page (strategy | impact | finance).
REVIEWERS=[{"name":"Veronica Mercado","email":"vmercado@bravofamilyfoundation.org","password":"change-me","lane":"strategy"},{"name":"Blanca Santos","email":"bsantos@bravofamilyfoundation.org","password":"change-me","lane":"impact"},{"name":"Kyle Klopfer","email":"kyle@example.com","password":"change-me","lane":"finance"}]

# Random string, 32+ characters. Used to sign login cookies.
SESSION_SECRET=replace-with-a-long-random-string

# ---- Public site ----------------------------------------------------------
# Used in emails and resume links.
NEXT_PUBLIC_SITE_URL=https://apply.bravofamilyfoundation.org
# Application deadline shown on the site (ISO date).
NEXT_PUBLIC_DEADLINE=2027-01-15
# Email shown in the footer for questions.
NEXT_PUBLIC_CONTACT_EMAIL=fellowship@bravofamilyfoundation.org

# ---- Headshot uploads (optional) -----------------------------------------
# Vercel → Project → Storage → Create Blob store. Vercel adds this variable
# automatically. Without it, applicants still see their photo while filling in
# the form, but it isn't saved for reviewers.
BLOB_READ_WRITE_TOKEN=
